/*
 * mkt_config.h - Build configuration (auto-generated by meson)
 *
 * This file is generated during the build process. Do not edit manually.
 * See meson.build for configuration options.
 */

#ifndef MKT_CONFIG_H
#define MKT_CONFIG_H

/*
 * SIMD mode configuration:
 * - MKT_SIMD_FULL=1: Hand-optimized SIMD + compiler baseline (default)
 * - MKT_SIMD_NONE=1: No SIMD, truly scalar
 * - Neither defined: Compiler-only vectorization
 */
#mesondefine MKT_SIMD_FULL
#mesondefine MKT_SIMD_NONE

/* SIMD mode as a string for diagnostics */
#mesondefine MKT_SIMD_MODE

/*
 * Coverage build: disables target_clones (multi-versioning) because each clone
 * is a separate function and only one runs on any given CPU.
 */
#mesondefine MKT_COVERAGE

/*
 * Sanitizer build: disables ifuncs because the resolver runs before the
 * sanitizer runtime is initialized, causing crashes on instrumented globals.
 */
#mesondefine MKT_SANITIZER

/*
 * F16C support: hardware half-precision ↔ float conversion. When defined,
 * mkt_half_to_float() compiles to a single vcvtsh2ss instruction instead of
 * a software fallback, enabling efficient inline f16 conversion in hot loops.
 */
#mesondefine MKT_HAVE_F16C

/*
 * CBLAS support: enables optimized matrix multiplication via BLAS library.
 * When available, batch encoding uses cblas_sgemm for ~4x speedup.
 */
#mesondefine MKT_HAVE_CBLAS

/*
 * FAISS support: enables benchmark comparison against FAISS RaBitQuantizer.
 * Requires FAISS built with the C API patch from third-party/.
 */
#mesondefine MKT_HAVE_FAISS

#endif /* MKT_CONFIG_H */
