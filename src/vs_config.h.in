/*
 * vs_config.h - Build configuration (auto-generated by meson)
 *
 * This file is generated during the build process. Do not edit manually.
 * See meson.build for configuration options.
 */

#ifndef VS_CONFIG_H
#define VS_CONFIG_H

/*
 * Project version (from meson.build). Single source of truth for the
 * version string surfaced by the CLI and the SQL version() function.
 */
#mesondefine VS_VERSION

/*
 * Extension naming (from meson.build, the single source of truth for
 * all user-facing names): the extension name, the index access method
 * name, and the GUC prefix (the prism index's tunables, tracks
 * VS_AM_NAME rather than VS_EXTENSION_NAME). C string literals that
 * surface any of these to users go through these defines; C-internal
 * identifiers keep literal names.
 */
#mesondefine VS_EXTENSION_NAME
#mesondefine VS_AM_NAME
#mesondefine VS_GUC_PREFIX

/*
 * Name of the version-named extension shared library
 * ("pg_vectorsearch-<version>"). Used where the library is referenced by name,
 * e.g. when launching parallel workers.
 */
#mesondefine VS_MODULE_NAME

/*
 * SIMD mode configuration:
 * - VS_SIMD_FULL=1: Hand-optimized SIMD + compiler baseline (default)
 * - VS_SIMD_NONE=1: No SIMD, truly scalar
 * - Neither defined: Compiler-only vectorization
 */
#mesondefine VS_SIMD_FULL
#mesondefine VS_SIMD_NONE

/* SIMD mode as a string for diagnostics */
#mesondefine VS_SIMD_MODE

/*
 * Coverage build: disables target_clones (multi-versioning) because each clone
 * is a separate function and only one runs on any given CPU.
 */
#mesondefine VS_COVERAGE

/*
 * Sanitizer build: disables ifuncs because the resolver runs before the
 * sanitizer runtime is initialized, causing crashes on instrumented globals.
 */
#mesondefine VS_SANITIZER

/*
 * F16C support: hardware half-precision ↔ float conversion. When defined,
 * vs_half_to_float() compiles to a single vcvtsh2ss instruction instead of
 * a software fallback, enabling efficient inline f16 conversion in hot loops.
 */
#mesondefine VS_HAVE_F16C

/*
 * CBLAS support: enables optimized matrix multiplication via BLAS library.
 * When available, batch encoding uses cblas_sgemm for ~4x speedup.
 *
 * VS_BLAS_OPENBLAS / VS_BLAS_BLIS are set when meson detects that
 * vendor specifically. The runtime thread-pinning code in
 * vs_cblas_pin_single_thread() uses them to decide which setter to
 * call (openblas_set_num_threads / bli_thread_set_num_threads).
 * Referencing such a symbol unconditionally breaks linking on macOS
 * with Accelerate (Mach-O has no portable "undefined weak reference
 * resolves to NULL" that survives LTO).
 */
#mesondefine VS_HAVE_CBLAS
#mesondefine VS_BLAS_OPENBLAS
#mesondefine VS_BLAS_BLIS

/*
 * HDF5 support: enables loading ann-benchmarks datasets. Used by
 * vectorsearch bench search --hdf5 to load train/test/neighbors/
 * distances datasets.
 */
#mesondefine VS_HAVE_HDF5

#endif /* VS_CONFIG_H */
