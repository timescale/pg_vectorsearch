/*
 * git_commit.h - Git commit of the source tree at build time.
 *
 * Generated by meson's vcs_tag() at build time. Re-runs when HEAD moves,
 * so rebuilding picks up a fresh commit without a full reconfigure.
 * Falls back to "unknown" when not built from a git checkout.
 */

#ifndef VS_GIT_COMMIT_H
#define VS_GIT_COMMIT_H

#define VS_GIT_COMMIT "@VCS_TAG@"

#endif /* VS_GIT_COMMIT_H */
