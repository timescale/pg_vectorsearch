-- Phase 0 incremental inserts across index variants.
--
-- aminsert indexes new rows into an existing index. Covered for AoS-only,
-- FASTSCAN (where inserts form a mixed AoS-overflow chain on the packed base),
-- and empty indexes (build is refused), plus nearest-neighbour membership of a
-- freshly inserted vec32. Probe vectors are widely separated so ANN ranking is
-- deterministic; region membership is asserted by id range where gaps are
-- small.
-- ===== AoS-only index (centroid_compression on, no fastscan) ================
CREATE TABLE mut (id int, v vec32(3));
INSERT INTO mut SELECT g, format('[%s,0,0]', g)::vec32 FROM generate_series(1, 50) g;
CREATE INDEX idx_mut ON mut USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
SET enable_seqscan = off;
SET prism.nprobe = 4;             -- = nlist: scan every list, deterministic
-- Guard: the ORDER BY probes below must be served by the index, not a seq scan
-- (enable_seqscan=off only penalizes seqscan, it does not forbid it, so a
-- regression that made the index unusable would silently fall back and the
-- correctness checks would still pass on the heap).
EXPLAIN (COSTS OFF) SELECT id FROM mut ORDER BY v <-> '[100,0,0]' LIMIT 1;
                  QUERY PLAN                  
----------------------------------------------
 Limit
   ->  Index Scan using idx_mut on mut
         Order By: (v <-> '[100,0,0]'::vec32)
(3 rows)

INSERT INTO mut VALUES (1001, '[100,0,0]');
SELECT count(*) AS aos_ins FROM (
    SELECT id FROM mut ORDER BY v <-> '[100,0,0]' LIMIT 1) t WHERE id = 1001;
 aos_ins 
---------
       1
(1 row)

-- Bulk insert into a new region grows AoS overflow pages. Verify that EVERY
-- row was indexed, not just one. A nearest-neighbour query is the wrong probe
-- for this: these axis-aligned 1-D vectors all quantize to near-identical
-- RaBitQ codes, so approximate ranking does not surface all 40 even when all
-- are present. Instead count physical index entries directly via
-- prism_posting_pages, which is independent of search recall: the index must
-- hold all 91 rows (50 initial + the 1001 outlier + 40 bulk).
INSERT INTO mut SELECT 2000 + g, format('[%s,0,0]', 300 + g)::vec32
    FROM generate_series(1, 40) g;
SELECT sum(entry_count) AS aos_total
    FROM prism_posting_pages('idx_mut'::regclass);
 aos_total 
-----------
        91
(1 row)

-- Separately, ANN ranking must return the true nearest neighbour: the probe
-- matches row 2020 exactly (distance 0), so it is the unambiguous top-1.
SELECT id AS aos_bulk_nn FROM mut ORDER BY v <-> '[320,0,0]' LIMIT 1;
 aos_bulk_nn 
-------------
        2020
(1 row)

RESET enable_seqscan;
RESET prism.nprobe;
DROP TABLE mut;
-- ===== FASTSCAN index: inserts append an AoS overflow page (mixed chain) =====
CREATE TABLE mutfs (id int, v vec32(3));
INSERT INTO mutfs SELECT g, format('[%s,0,0]', g)::vec32
    FROM generate_series(1, 60) g;
CREATE INDEX idx_mutfs ON mutfs USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = on,
          soar_lambda = 0, boundary_epsilon = 0);
SET enable_seqscan = off;
SET prism.nprobe = 4;
-- Guard: index serves the probe, not a seq scan (see the AoS section).
EXPLAIN (COSTS OFF) SELECT id FROM mutfs ORDER BY v <-> '[500,0,0]' LIMIT 1;
                  QUERY PLAN                  
----------------------------------------------
 Limit
   ->  Index Scan using idx_mutfs on mutfs
         Order By: (v <-> '[500,0,0]'::vec32)
(3 rows)

INSERT INTO mutfs VALUES (1001, '[500,0,0]');
SELECT count(*) AS fs_ins FROM (
    SELECT id FROM mutfs ORDER BY v <-> '[500,0,0]' LIMIT 1) t WHERE id = 1001;
 fs_ins 
--------
      1
(1 row)

-- mixed chain: a query whose top-2 spans the FASTSCAN base (id 60) and the
-- AoS-inserted neighbour (id 61) must return both.
INSERT INTO mutfs VALUES (61, '[61,0,0]');
SELECT count(*) AS fs_mixed FROM (
    SELECT id FROM mutfs ORDER BY v <-> '[61,0,0]' LIMIT 2) t
    WHERE id IN (60, 61);
 fs_mixed 
----------
        2
(1 row)

RESET enable_seqscan;
RESET prism.nprobe;
DROP TABLE mutfs;
-- ===== Empty index: building on a 0-row table succeeds =======================
-- The build substitutes a synthetic sample and emits a degenerate
-- single-cluster index that later inserts route into. Full coverage lives
-- in the empty_table test; here we just pin that the build no longer errors.
CREATE TABLE mutempty (id int, v vec32(3));
CREATE INDEX idx_mutempty ON mutempty USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
DROP TABLE mutempty;
-- ===== A freshly inserted vec32 is a genuine nearest neighbour =============
CREATE TABLE mutnn (id int, v vec32(3));
INSERT INTO mutnn SELECT g, format('[%s,0,0]', g)::vec32
    FROM generate_series(1, 50) g;
CREATE INDEX idx_mutnn ON mutnn USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
SET enable_seqscan = off;
SET prism.nprobe = 4;
-- Guard: index serves the probe, not a seq scan (see the AoS section).
EXPLAIN (COSTS OFF) SELECT id FROM mutnn ORDER BY v <-> '[99,0,0]' LIMIT 1;
                 QUERY PLAN                  
---------------------------------------------
 Limit
   ->  Index Scan using idx_mutnn on mutnn
         Order By: (v <-> '[99,0,0]'::vec32)
(3 rows)

INSERT INTO mutnn VALUES (1001, '[100,0,0]');
-- query NEAR (not equal to) the inserted vec32; it must be the top neighbour
SELECT count(*) AS nn_member FROM (
    SELECT id FROM mutnn ORDER BY v <-> '[99,0,0]' LIMIT 1) t WHERE id = 1001;
 nn_member 
-----------
         1
(1 row)

RESET enable_seqscan;
RESET prism.nprobe;
DROP TABLE mutnn;
-- ===== DELETE: dead rows leave the result; VACUUM tombstones the entries =====
-- A deleted row must never be returned by an index scan (MVCC filters it even
-- before VACUUM), and VACUUM's ambulkdelete must run cleanly and tombstone the
-- dead entries while leaving the rest of the index correct and usable. Probes
-- are outliers so the assertions are exact-NN, not recall-dependent.
CREATE TABLE mutdel (id int, v vec32(3));
INSERT INTO mutdel SELECT g, format('[%s,0,0]', g)::vec32
    FROM generate_series(1, 50) g;
INSERT INTO mutdel VALUES (1001, '[100,0,0]'), (1002, '[200,0,0]');
CREATE INDEX idx_mutdel ON mutdel USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
SET enable_seqscan = off;
SET prism.nprobe = 4;
-- Guard: index serves the probe, not a seq scan (see the AoS section).
EXPLAIN (COSTS OFF) SELECT id FROM mutdel ORDER BY v <-> '[100,0,0]' LIMIT 1;
                  QUERY PLAN                  
----------------------------------------------
 Limit
   ->  Index Scan using idx_mutdel on mutdel
         Order By: (v <-> '[100,0,0]'::vec32)
(3 rows)

-- Present before delete: the [100] outlier is its own nearest neighbour.
SELECT id AS del_before FROM mutdel ORDER BY v <-> '[100,0,0]' LIMIT 1;
 del_before 
------------
       1001
(1 row)

DELETE FROM mutdel WHERE id = 1001;
-- Gone immediately (MVCC recheck), even though VACUUM has not run: the nearest
-- live row to [100] is now id 50, not the deleted 1001.
SELECT id AS del_after FROM mutdel ORDER BY v <-> '[100,0,0]' LIMIT 1;
 del_after 
-----------
        50
(1 row)

-- Physical entries are unchanged by DELETE (no reclaim yet): 52 rows indexed,
-- and none are marked dead yet — only VACUUM's ambulkdelete marks entries.
SELECT sum(entry_count) AS del_entries_pre_vacuum,
       sum(dead_count) AS del_dead_pre_vacuum
    FROM prism_posting_pages('idx_mutdel'::regclass);
 del_entries_pre_vacuum | del_dead_pre_vacuum 
------------------------+---------------------
                     52 |                   0
(1 row)

VACUUM mutdel;   -- runs ambulkdelete: tombstones the dead 1001 entry
-- Still correct after VACUUM, and the other outlier is unaffected.
SELECT id AS del_after_vacuum FROM mutdel ORDER BY v <-> '[100,0,0]' LIMIT 1;
 del_after_vacuum 
------------------
               50
(1 row)

SELECT id AS del_other FROM mutdel ORDER BY v <-> '[200,0,0]' LIMIT 1;
 del_other 
-----------
      1002
(1 row)

-- Tombstones are skipped, not physically removed in Phase 0, so the page entry
-- count is unchanged; exactly the one deleted row is now marked dead.
SELECT sum(entry_count) AS del_entries_post_vacuum,
       sum(dead_count) AS del_dead_post_vacuum
    FROM prism_posting_pages('idx_mutdel'::regclass);
 del_entries_post_vacuum | del_dead_post_vacuum 
-------------------------+----------------------
                      52 |                    1
(1 row)

-- VACUUM page-tombstones only pages left all-dead. The deleted outlier sat
-- alone in its own cluster, so exactly its page becomes all-dead and is
-- flagged (its single entry marked dead); the dense pages keep live entries
-- and must not be flagged.
SELECT count(*) AS del_tombstoned_pages,
       coalesce(bool_and(entry_count = 1), true) AS only_the_dead_entry,
       coalesce(bool_and(dead_count = entry_count), true) AS all_entries_dead
    FROM prism_posting_pages('idx_mutdel'::regclass)
    WHERE tombstoned;
 del_tombstoned_pages | only_the_dead_entry | all_entries_dead 
----------------------+---------------------+------------------
                    1 | t                   | t
(1 row)

RESET enable_seqscan;
RESET prism.nprobe;
DROP TABLE mutdel;
-- ===== UPDATE: insert-new + clean-old, and HOT for non-indexed columns =======
-- Postgres turns a vec32-column UPDATE into a new tuple (aminsert) plus a dead
-- old version (cleaned by VACUUM, like DELETE). An UPDATE that leaves the
-- vec32 unchanged is HOT when the page has room, so no index work happens and
-- the row stays findable. The payload column is non-indexed, to drive the HOT
-- case.
CREATE TABLE mutupd (id int, payload int, v vec32(3));
INSERT INTO mutupd SELECT g, 0, format('[%s,0,0]', g)::vec32
    FROM generate_series(1, 50) g;
INSERT INTO mutupd VALUES (1001, 0, '[100,0,0]');
CREATE INDEX idx_mutupd ON mutupd USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
SET enable_seqscan = off;
SET prism.nprobe = 4;
-- Guard: index serves the probe, not a seq scan (see the AoS section).
EXPLAIN (COSTS OFF) SELECT id FROM mutupd ORDER BY v <-> '[100,0,0]' LIMIT 1;
                  QUERY PLAN                  
----------------------------------------------
 Limit
   ->  Index Scan using idx_mutupd on mutupd
         Order By: (v <-> '[100,0,0]'::vec32)
(3 rows)

-- Before: the outlier sits at [100].
SELECT id AS upd_before FROM mutupd ORDER BY v <-> '[100,0,0]' LIMIT 1;
 upd_before 
------------
       1001
(1 row)

-- Move the vec32 to [200]: non-HOT, so aminsert indexes the new version.
UPDATE mutupd SET v = '[200,0,0]' WHERE id = 1001;
-- New location is found ...
SELECT id AS upd_new_loc FROM mutupd ORDER BY v <-> '[200,0,0]' LIMIT 1;
 upd_new_loc 
-------------
        1001
(1 row)

-- ... and the old location no longer returns it (dead old version, MVCC): the
-- nearest live row to [100] is id 50.
SELECT id AS upd_old_loc FROM mutupd ORDER BY v <-> '[100,0,0]' LIMIT 1;
 upd_old_loc 
-------------
          50
(1 row)

-- HOT update of a non-indexed column does no index work; the row is unchanged
-- in the index and still found at [200].
UPDATE mutupd SET payload = payload + 1 WHERE id = 1001;
SELECT id AS upd_hot FROM mutupd ORDER BY v <-> '[200,0,0]' LIMIT 1;
 upd_hot 
---------
    1001
(1 row)

-- VACUUM cleans the dead old version; the current version stays findable.
VACUUM mutupd;
SELECT id AS upd_after_vacuum FROM mutupd ORDER BY v <-> '[200,0,0]' LIMIT 1;
 upd_after_vacuum 
------------------
             1001
(1 row)

RESET enable_seqscan;
RESET prism.nprobe;
DROP TABLE mutupd;
-- ===== Non-HOT UPDATE of a non-indexed column still indexes the new version ==
-- When the page has no room for the new version, an UPDATE that leaves the
-- vec32 unchanged is not HOT: the new tuple lands on another page and
-- Postgres calls aminsert for it with index_unchanged = true. That flag is a
-- hint for access methods that can deduplicate against the old version, not
-- permission to skip the insert -- the old entry points at a TID that is now
-- dead. Sequential inserts pack every page but the last to the fill factor,
-- so updating every row forces the non-HOT path for all but the last page.
CREATE TABLE mutnonhot (id int, payload int, v vec32(3));
INSERT INTO mutnonhot SELECT g, 0, format('[%s,0,0]', g)::vec32
    FROM generate_series(1, 1000) g;
CREATE INDEX idx_mutnonhot ON mutnonhot USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
SET enable_seqscan = off;
SET prism.nprobe = 4;
SELECT sum(entry_count) AS entries_before
    FROM prism_posting_pages('idx_mutnonhot'::regclass);
 entries_before 
----------------
           1000
(1 row)

UPDATE mutnonhot SET payload = payload + 1;
-- The new versions were indexed: more entries than rows ...
SELECT sum(entry_count) > 1000 AS entries_added
    FROM prism_posting_pages('idx_mutnonhot'::regclass);
 entries_added 
---------------
 t
(1 row)

-- ... and a row from a full page is found at its unchanged vec32.
SELECT id AS nonhot_found FROM mutnonhot ORDER BY v <-> '[500,0,0]' LIMIT 1;
 nonhot_found 
--------------
          500
(1 row)

-- Once VACUUM has removed the dead old versions, the whole table is
-- reachable through the index (before it, the dead entries take half the
-- top-k and the heap fetch drops them).
VACUUM mutnonhot;
SET prism.query_limit = 1000;
SELECT count(*) AS nonhot_reachable FROM (
    SELECT id FROM mutnonhot ORDER BY v <-> '[0,0,0]' LIMIT 1000) t;
 nonhot_reachable 
------------------
             1000
(1 row)

RESET prism.query_limit;
RESET enable_seqscan;
RESET prism.nprobe;
DROP TABLE mutnonhot;
-- ===== Page-level tombstone is reported by EXPLAIN (ANALYZE, VERBOSE) ========
-- A scan reads a tombstoned (all-dead) page to follow the chain but skips its
-- scoring, so EXPLAIN reports Posting Pages Scanned + Dead Pages Skipped, with
-- scanned = read - skipped. Asserted via the FORMAT JSON plan so exact page
-- counts (layout-dependent) don't make the test brittle: before any delete
-- nothing is skipped (scanned == read); after deleting every row + VACUUM every
-- probed page is tombstoned (skipped > 0, nothing scored).
CREATE TABLE muttomb (id int, v vec32(3));
INSERT INTO muttomb SELECT g, format('[%s,0,0]', g)::vec32
    FROM generate_series(1, 200) g;
CREATE INDEX idx_muttomb ON muttomb USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
SET enable_seqscan = off;
SET prism.nprobe = 4;
CREATE FUNCTION muttomb_pages()
    RETURNS TABLE (pages_read int, pages_scanned int, pages_skipped int)
    LANGUAGE plpgsql AS $$
DECLARE
    j json;
    s json;
BEGIN
    EXECUTE 'EXPLAIN (ANALYZE, VERBOSE, COSTS OFF, FORMAT JSON)
        SELECT id FROM muttomb ORDER BY v <-> ''[1,0,0]'' LIMIT 5'
    INTO j;
    s := j -> 0 -> 'Plan' -> 'Plans' -> 0 -> 'Prism';
    RETURN QUERY SELECT
        (s ->> 'Posting Pages Read')::int,
        (s ->> 'Posting Pages Scanned')::int,
        (s ->> 'Posting Dead Pages Skipped')::int;
END $$;
-- No tombstones yet: nothing skipped, every read page is scored, and
-- prism_posting_pages reports no page as tombstoned.
SELECT pages_skipped = 0 AS none_skipped_before,
       pages_scanned = pages_read AS all_scanned_before
    FROM muttomb_pages();
 none_skipped_before | all_scanned_before 
---------------------+--------------------
 t                   | t
(1 row)

SELECT count(*) FILTER (WHERE tombstoned) AS tombstoned_before
    FROM prism_posting_pages('idx_muttomb'::regclass);
 tombstoned_before 
-------------------
                 0
(1 row)

DELETE FROM muttomb;
VACUUM muttomb;
-- Every page is now all-dead: all read pages are skipped, none scored.
SELECT pages_skipped > 0 AS some_skipped_after,
       pages_scanned = 0 AS none_scanned_after
    FROM muttomb_pages();
 some_skipped_after | none_scanned_after 
--------------------+--------------------
 t                  | t
(1 row)

-- prism_posting_pages agrees: every posting page is flagged tombstoned, and the
-- pages stay linked in their chains (tombstoning is a scan optimization, not
-- reclamation).
SELECT count(*) > 0 AS have_pages,
       bool_and(tombstoned) AS all_tombstoned
    FROM prism_posting_pages('idx_muttomb'::regclass);
 have_pages | all_tombstoned 
------------+----------------
 t          | t
(1 row)

DROP FUNCTION muttomb_pages();
RESET enable_seqscan;
RESET prism.nprobe;
DROP TABLE muttomb;
-- ===== FASTSCAN pages are page-tombstoned and reported =======================
-- Page-level tombstoning is the only delete granularity for FASTSCAN postings
-- (packed 32-vec32 groups cannot be flagged per entry), so the tombstoned
-- column must work on fastscan-format pages, not just AoS.
CREATE TABLE mutfstomb (id int, v vec32(3));
INSERT INTO mutfstomb SELECT g, format('[%s,0,0]', g)::vec32
    FROM generate_series(1, 200) g;
CREATE INDEX idx_mutfstomb ON mutfstomb USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = on,
          soar_lambda = 0, boundary_epsilon = 0);
-- The build produced fastscan pages and none are tombstoned yet. dead_count
-- is NULL for fastscan pages: packed groups have no per-entry DELETED state.
SELECT count(*) FILTER (WHERE format = 'fastscan') > 0 AS has_fastscan_pages,
       count(*) FILTER (WHERE tombstoned) AS tombstoned_before,
       bool_and(dead_count IS NULL)
           FILTER (WHERE format = 'fastscan') AS fastscan_dead_is_null
    FROM prism_posting_pages('idx_mutfstomb'::regclass);
 has_fastscan_pages | tombstoned_before | fastscan_dead_is_null 
--------------------+-------------------+-----------------------
 t                  |                 0 | t
(1 row)

DELETE FROM mutfstomb;
VACUUM mutfstomb;
-- Every page — fastscan base included — is all-dead and flagged.
SELECT count(*) > 0 AS have_pages,
       bool_and(tombstoned) AS all_tombstoned
    FROM prism_posting_pages('idx_mutfstomb'::regclass);
 have_pages | all_tombstoned 
------------+----------------
 t          | t
(1 row)

DROP TABLE mutfstomb;
-- ===== Dead-entry accounting across the delete lifecycle =====================
-- The monitoring story for prism_posting_pages: dead_count accumulates with each
-- DELETE + VACUUM round while pages holding live entries stay untombstoned;
-- tombstoned flips only when a page goes all-dead, at which point
-- dead_count = entry_count. Deletes are spread (every 5th id) so no cluster
-- goes all-dead early, keeping the intermediate states layout-independent.
CREATE TABLE mutlife (id int, v vec32(3));
INSERT INTO mutlife SELECT g, format('[%s,0,0]', g)::vec32
    FROM generate_series(1, 50) g;
CREATE INDEX idx_mutlife ON mutlife USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
-- Baseline: 50 entries, nothing dead, nothing tombstoned.
SELECT sum(entry_count) AS entries,
       sum(dead_count) AS dead,
       count(*) FILTER (WHERE tombstoned) AS tombstoned_pages
    FROM prism_posting_pages('idx_mutlife'::regclass);
 entries | dead | tombstoned_pages 
---------+------+------------------
      50 |    0 |                0
(1 row)

-- Round 1: delete every 5th row. Before VACUUM nothing is marked ...
DELETE FROM mutlife WHERE id % 5 = 0;
SELECT sum(dead_count) AS dead_marked_pre_vacuum
    FROM prism_posting_pages('idx_mutlife'::regclass);
 dead_marked_pre_vacuum 
------------------------
                      0
(1 row)

-- ... after VACUUM exactly those 10 are marked dead, spread across clusters,
-- so every page keeps live entries and none is tombstoned.
VACUUM mutlife;
SELECT sum(entry_count) AS entries,
       sum(dead_count) AS dead,
       count(*) FILTER (WHERE tombstoned) AS tombstoned_pages,
       bool_and(dead_count < entry_count) AS all_pages_have_live
    FROM prism_posting_pages('idx_mutlife'::regclass);
 entries | dead | tombstoned_pages | all_pages_have_live 
---------+------+------------------+---------------------
      50 |   10 |                0 | t
(1 row)

-- Round 2: delete another slice; dead_count accumulates monotonically.
DELETE FROM mutlife WHERE id % 5 = 1;
VACUUM mutlife;
SELECT sum(entry_count) AS entries,
       sum(dead_count) AS dead,
       count(*) FILTER (WHERE tombstoned) AS tombstoned_pages
    FROM prism_posting_pages('idx_mutlife'::regclass);
 entries | dead | tombstoned_pages 
---------+------+------------------
      50 |   20 |                0
(1 row)

-- Round 3: delete everything left; every page goes all-dead, tombstoned flips
-- everywhere, and dead_count = entry_count on every page.
DELETE FROM mutlife;
VACUUM mutlife;
SELECT sum(entry_count) AS entries,
       sum(dead_count) AS dead,
       count(*) > 0 AND bool_and(tombstoned) AS all_tombstoned,
       bool_and(dead_count = entry_count) AS all_entries_dead
    FROM prism_posting_pages('idx_mutlife'::regclass);
 entries | dead | all_tombstoned | all_entries_dead 
---------+------+----------------+------------------
      50 |   50 | t              | t
(1 row)

DROP TABLE mutlife;
-- ===== Mixed state: dead-region chains tombstone, live regions do not =======
-- A bulk range delete (the lower half of the band) kills entire clusters —
-- their chains tombstone — while the upper clusters keep live entries: one
-- index holding tombstoned and live pages side by side. The per-page invariant
-- ties the two columns together: a page is tombstoned iff dead_count equals
-- entry_count. Which clusters die exactly is layout-dependent, so assertions
-- are existential (some tombstoned, some live) plus index-wide sums.
CREATE TABLE mutmix (id int, v vec32(3));
INSERT INTO mutmix SELECT g, format('[%s,0,0]', g)::vec32
    FROM generate_series(1, 50) g;
CREATE INDEX idx_mutmix ON mutmix USING prism (v)
    WITH (nlist = 4, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
SET enable_seqscan = off;
SET prism.nprobe = 4;
-- Guard: index serves the probe, not a seq scan (see the AoS section).
EXPLAIN (COSTS OFF) SELECT id FROM mutmix ORDER BY v <-> '[1,0,0]' LIMIT 1;
                 QUERY PLAN                  
---------------------------------------------
 Limit
   ->  Index Scan using idx_mutmix on mutmix
         Order By: (v <-> '[1,0,0]'::vec32)
(3 rows)

DELETE FROM mutmix WHERE id <= 25;
VACUUM mutmix;
-- Mixed page state: some pages tombstoned (clusters wholly inside the deleted
-- range), some live, with exactly the 25 deleted rows marked dead index-wide.
SELECT count(*) FILTER (WHERE tombstoned) > 0 AS some_tombstoned,
       count(*) FILTER (WHERE NOT tombstoned) > 0 AS some_live,
       sum(entry_count) AS entries,
       sum(dead_count) AS dead
    FROM prism_posting_pages('idx_mutmix'::regclass);
 some_tombstoned | some_live | entries | dead 
-----------------+-----------+---------+------
 t               | t         |      50 |   25
(1 row)

-- The invariant on every page: tombstoned iff every entry is dead.
SELECT bool_and((dead_count = entry_count) = tombstoned) AS tombstone_iff_all_dead
    FROM prism_posting_pages('idx_mutmix'::regclass);
 tombstone_iff_all_dead 
------------------------
 t
(1 row)

-- Queries keep working across the mix: probing into the dead region returns
-- the nearest live row (id 26), served by the index.
SELECT id AS nearest_live FROM mutmix ORDER BY v <-> '[1,0,0]' LIMIT 1;
 nearest_live 
--------------
           26
(1 row)

RESET enable_seqscan;
RESET prism.nprobe;
DROP TABLE mutmix;
-- ===== One tombstoned page inside a multi-page chain =========================
-- Tombstoning is per page, not per chain: killing exactly one interior page of
-- a long chain must flag that page alone, leave the chain fully linked (the
-- tombstoned page is skipped, not unlinked), and show up in the scan stats as
-- one skipped page with the read count unchanged.
--
-- Chain construction: the index is built on a small seed, then aminsert grows
-- one cluster's chain page by page. Inserts append at the chain tail, so pages
-- hold contiguous id slices in chain order and the id range of any page can be
-- computed from cumulative entry counts — no dependence on page capacity.
CREATE TABLE mutchain (id int, v vec32(3));
-- Seed: two well-separated regions so the build creates two clusters.
INSERT INTO mutchain SELECT g, format('[%s,0,0]', g * 0.01)::vec32
    FROM generate_series(1, 10) g;
INSERT INTO mutchain SELECT 10000 + g, format('[%s,0,0]', 1000 + g * 0.01)::vec32
    FROM generate_series(1, 10) g;
CREATE INDEX idx_mutchain ON mutchain USING prism (v)
    WITH (nlist = 2, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
-- Grow the first region's chain: ids 11..1210 all route to its cluster.
INSERT INTO mutchain SELECT g, format('[%s,0,0]', g * 0.01)::vec32
    FROM generate_series(11, 1210) g;
SET enable_seqscan = off;
SET prism.nprobe = 1;
-- Snapshot the big cluster's chain (the one that grew) before any delete.
CREATE TEMP TABLE chain_before AS
    SELECT blkno, chain_pos, entry_count
        FROM prism_posting_pages('idx_mutchain'::regclass)
        WHERE cluster_id = (
            SELECT cluster_id FROM prism_posting_pages('idx_mutchain'::regclass)
            GROUP BY cluster_id ORDER BY count(*) DESC LIMIT 1);
-- The chain is long enough that chain_pos=2 is an interior page (neither the
-- head nor the tail).
SELECT count(*) >= 4 AS chain_has_interior_pages,
       max(chain_pos) + 1 = count(*) AS chain_gapless
    FROM chain_before;
 chain_has_interior_pages | chain_gapless 
--------------------------+---------------
 t                        | t
(1 row)

-- EXPLAIN scan-stats probe into the big cluster (same JSON extraction as the
-- page-tombstone section above).
CREATE FUNCTION mutchain_pages()
    RETURNS TABLE (pages_read int, pages_scanned int, pages_skipped int)
    LANGUAGE plpgsql AS $$
DECLARE
    j json;
    s json;
BEGIN
    EXECUTE 'EXPLAIN (ANALYZE, VERBOSE, COSTS OFF, FORMAT JSON)
        SELECT id FROM mutchain ORDER BY v <-> ''[0.05,0,0]'' LIMIT 5'
    INTO j;
    s := j -> 0 -> 'Plan' -> 'Plans' -> 0 -> 'Prism';
    RETURN QUERY SELECT
        (s ->> 'Posting Pages Read')::int,
        (s ->> 'Posting Pages Scanned')::int,
        (s ->> 'Posting Dead Pages Skipped')::int;
END $$;
CREATE TEMP TABLE stats_before AS SELECT * FROM mutchain_pages();
SELECT pages_skipped = 0 AS none_skipped_before,
       pages_scanned = pages_read AS all_scanned_before
    FROM stats_before;
 none_skipped_before | all_scanned_before 
---------------------+--------------------
 t                   | t
(1 row)

-- Kill exactly the interior page at chain_pos=2: its id slice is
-- (entries on pages 0..1, entries on pages 0..2].
DELETE FROM mutchain WHERE id
    BETWEEN (SELECT sum(entry_count) FILTER (WHERE chain_pos < 2) + 1
                 FROM chain_before)
        AND (SELECT sum(entry_count) FILTER (WHERE chain_pos <= 2)
                 FROM chain_before);
VACUUM mutchain;
-- Exactly one page is tombstoned, it is the interior page, all its entries are
-- dead, and every other page keeps live entries.
SELECT count(*) FILTER (WHERE tombstoned) = 1 AS one_tombstoned,
       bool_and(chain_pos = 2) FILTER (WHERE tombstoned) AS it_is_the_interior,
       bool_and(dead_count = entry_count)
           FILTER (WHERE tombstoned) AS interior_all_dead,
       bool_and(dead_count < entry_count)
           FILTER (WHERE NOT tombstoned) AS others_have_live
    FROM prism_posting_pages('idx_mutchain'::regclass)
    WHERE blkno IN (SELECT blkno FROM chain_before);
 one_tombstoned | it_is_the_interior | interior_all_dead | others_have_live 
----------------+--------------------+-------------------+------------------
 t              | t                  | t                 | t
(1 row)

-- The chain stays complete: prism_posting_pages walks next_blkno links, so an
-- unlinked page would vanish from the walk. Same pages, same order, same
-- entry counts (tombstoning reclaims nothing).
SELECT (SELECT array_agg(blkno ORDER BY chain_pos) FROM chain_before) =
       array_agg(blkno ORDER BY chain_pos) AS chain_unchanged,
       (SELECT sum(entry_count) FROM chain_before) =
       sum(entry_count) AS entries_unchanged
    FROM prism_posting_pages('idx_mutchain'::regclass)
    WHERE blkno IN (SELECT blkno FROM chain_before);
 chain_unchanged | entries_unchanged 
-----------------+-------------------
 t               | t
(1 row)

-- The scan follows the chain across the tombstoned page (read count is
-- unchanged) but skips its scoring: exactly one page skipped, one fewer
-- scanned.
SELECT s.pages_read = b.pages_read AS read_unchanged,
       s.pages_skipped = 1 AS one_skipped,
       s.pages_scanned = b.pages_scanned - 1 AS one_fewer_scanned
    FROM mutchain_pages() s, stats_before b;
 read_unchanged | one_skipped | one_fewer_scanned 
----------------+-------------+-------------------
 t              | t           | t
(1 row)

DROP FUNCTION mutchain_pages();
DROP TABLE chain_before;
DROP TABLE stats_before;
RESET enable_seqscan;
RESET prism.nprobe;
DROP TABLE mutchain;
-- ===== A split-appended centroid page must not look like corruption (#262) ===
-- A posting-list split that needs to grow the centroid tree but finds no room
-- on the level-0 page appends a new centroid page by extending the relation
-- (see posting_split.c's `!appended` branch), landing it past every existing
-- posting page. ambulkdelete classifies each page it scans by its own
-- page_id rather than by block position specifically to handle this: VACUUM
-- must not warn the index may be corrupt over a page that carries no heap
-- TIDs and was never misread or modified. append_centroid_page reproduces
-- the exact shape without needing enough real splits to overflow a page for
-- real.
\getenv abs_srcdir PG_ABS_SRCDIR
\set helper_sql :abs_srcdir '/sql/test_helpers.sql'
\i :helper_sql
-- Silence this file's own definitions and documentation so they stay
-- out of the expected output of any test that includes it. Capture the
-- caller's current ECHO into a variable and restore it at the end
-- (below) rather than assuming a value, so whatever the including test
-- was using keeps working. Everything past \set ECHO none -- these
-- comments included -- is read with echo off.
\set saved_echo :ECHO
\set ECHO none
CREATE TABLE mutcentroid (id int, v vec32(3));
INSERT INTO mutcentroid SELECT g, format('[%s,0,0]', g)::vec32
    FROM generate_series(1, 20) g;
CREATE INDEX idx_mutcentroid ON mutcentroid USING prism (v)
    WITH (nlist = 2, centroid_compression = true, fastscan = off,
          soar_lambda = 0, boundary_epsilon = 0);
-- Snapshot the posting pages the centroid tree actually reaches, before
-- appending the orphan centroid page.
CREATE TEMP TABLE mutcentroid_before AS
    SELECT blkno FROM prism_posting_pages('idx_mutcentroid'::regclass);
-- The new page must land past every existing posting page -- the same
-- position a real overflowing split would leave it in.
SELECT append_centroid_page('idx_mutcentroid'::regclass) >
       (SELECT max(blkno) FROM mutcentroid_before) AS appended_past_posting;
 appended_past_posting 
-----------------------
 t
(1 row)

DELETE FROM mutcentroid WHERE id = 1;
VACUUM mutcentroid; -- runs ambulkdelete; must not warn the index may be corrupt
-- The orphan page is not linked from the tree, so a tree walk (what
-- prism_posting_pages and an ordinary scan both do) never reaches it: same
-- posting pages as before, and the index is still correct and usable.
SELECT (SELECT array_agg(blkno ORDER BY blkno) FROM mutcentroid_before) =
       array_agg(blkno ORDER BY blkno) AS tree_walk_unaffected
    FROM prism_posting_pages('idx_mutcentroid'::regclass);
 tree_walk_unaffected 
----------------------
 t
(1 row)

SELECT id FROM mutcentroid ORDER BY v <-> '[2,0,0]' LIMIT 1;
 id 
----
  2
(1 row)

DROP FUNCTION rabitq_params_cache();
DROP FUNCTION rabitq_cache_clear();
DROP FUNCTION append_centroid_page(regclass);
DROP TABLE mutcentroid_before;
DROP TABLE mutcentroid;
