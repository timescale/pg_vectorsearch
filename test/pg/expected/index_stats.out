-- Planner-visible index statistics
--
-- The planner reads an index's pg_class.reltuples as indexinfo->tuples, so
-- it has to track the number of indexed heap rows through the index's
-- life: set by the build, kept by a VACUUM that removes nothing, updated
-- to the live row count by one that does, and never inflated by the
-- extra posting entries SOAR and boundary replication add for the same
-- row.
CREATE TABLE index_stats_test (id serial, v vec32(8));
INSERT INTO index_stats_test (v)
    SELECT (SELECT array_agg(sin(i * 0.3 + j * 1.1)::real)
            FROM generate_series(0, 7) j)::vec32(8)
    FROM generate_series(1, 2000) i;
-- Replication on, so posting entries outnumber rows.
CREATE INDEX index_stats_idx ON index_stats_test USING prism (v)
    WITH (nlist = 16, soar_lambda = 1.0, boundary_epsilon = 0.35);
-- The build reports the rows it indexed.
SELECT reltuples AS reltuples_after_build
    FROM pg_class WHERE relname = 'index_stats_idx';
 reltuples_after_build 
-----------------------
                  2000
(1 row)

-- A VACUUM with nothing to remove leaves the count alone: reporting a
-- zeroed result here is what reset reltuples to 0 on every such VACUUM.
VACUUM index_stats_test;
SELECT reltuples AS reltuples_after_empty_vacuum
    FROM pg_class WHERE relname = 'index_stats_idx';
 reltuples_after_empty_vacuum 
------------------------------
                         2000
(1 row)

-- A VACUUM that removes rows reports the live heap count, not the live
-- posting-entry count: the entries include replicas, so their sum would
-- overstate the rows by the replication factor.
DELETE FROM index_stats_test WHERE id % 4 = 0;
VACUUM index_stats_test;
SELECT reltuples AS reltuples_after_delete_vacuum,
       (SELECT count(*) FROM index_stats_test) AS live_rows
    FROM pg_class WHERE relname = 'index_stats_idx';
 reltuples_after_delete_vacuum | live_rows 
-------------------------------+-----------
                          1500 |      1500
(1 row)

-- ANALYZE agrees with it.
ANALYZE index_stats_test;
SELECT reltuples AS reltuples_after_analyze
    FROM pg_class WHERE relname = 'index_stats_idx';
 reltuples_after_analyze 
-------------------------
                    1500
(1 row)

DROP TABLE index_stats_test;
