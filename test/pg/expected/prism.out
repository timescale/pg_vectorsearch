SET enable_seqscan = off;
EXPLAIN (COSTS OFF)
SELECT id, v <-> '[0.5,0.5,0.5]' AS dist
    FROM embeddings ORDER BY v <-> '[0.5,0.5,0.5]' LIMIT 5;
