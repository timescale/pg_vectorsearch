-- Vector type I/O, typmod, casts, comparison
-- Basic I/O
SELECT '[1,2,3]'::vector;
 vector  
---------
 [1,2,3]
(1 row)

SELECT '[1.5,-2.3,0]'::vector;
    vector    
--------------
 [1.5,-2.3,0]
(1 row)

SELECT '[0]'::vector;
 vector 
--------
 [0]
(1 row)

-- Typmod
SELECT '[1,2,3]'::vector(3);
 vector  
---------
 [1,2,3]
(1 row)

-- Typmod mismatch
SELECT '[1,2,3]'::vector(2); -- error
ERROR:  expected 2 dimensions, not 3
-- Empty vector
SELECT '[]'::vector; -- error
ERROR:  vector must have at least 1 dimension
LINE 1: SELECT '[]'::vector;
               ^
-- NaN
SELECT '[1,NaN,3]'::vector; -- error
ERROR:  NaN value not allowed in vector
LINE 1: SELECT '[1,NaN,3]'::vector;
               ^
-- Inf
SELECT '[1,Inf,3]'::vector; -- error
ERROR:  infinite value not allowed in vector
LINE 1: SELECT '[1,Inf,3]'::vector;
               ^
-- Bad syntax
SELECT '[1,2,'::vector; -- error
ERROR:  invalid input syntax for type vector: "[1,2,"
LINE 1: SELECT '[1,2,'::vector;
               ^
SELECT '1,2,3'::vector; -- error
ERROR:  vector must start with "["
LINE 1: SELECT '1,2,3'::vector;
               ^
SELECT '[1 2]'::vector; -- error: missing comma
ERROR:  expected "," or "]" in vector
LINE 1: SELECT '[1 2]'::vector;
               ^
SELECT '[1,2]abc'::vector; -- error: trailing content
ERROR:  unexpected characters after "]" in vector
LINE 1: SELECT '[1,2]abc'::vector;
               ^
-- Leading/trailing whitespace
SELECT '  [1,2,3]  '::vector;
 vector  
---------
 [1,2,3]
(1 row)

-- Spaces between elements
SELECT '[ 1 , 2 , 3 ]'::vector;
 vector  
---------
 [1,2,3]
(1 row)

-- Utility functions
SELECT vector_dims('[1,2,3]'::vector);
 vector_dims 
-------------
           3
(1 row)

SELECT vector_norm('[3,4]'::vector);
 vector_norm 
-------------
           5
(1 row)

-- Table storage
CREATE TABLE t_vec (id serial, v vector(3));
INSERT INTO t_vec (v) VALUES ('[1,0,0]'), ('[0,1,0]'), ('[0,0,1]');
SELECT * FROM t_vec ORDER BY id;
 id |    v    
----+---------
  1 | [1,0,0]
  2 | [0,1,0]
  3 | [0,0,1]
(3 rows)

-- Array cast
SELECT ARRAY[1.0,2.0,3.0]::real[]::vector;
  array  
---------
 [1,2,3]
(1 row)

SELECT ARRAY[1.0,2.0,3.0]::float8[]::vector;
  array  
---------
 [1,2,3]
(1 row)

-- Vector to array
SELECT ('[1,2,3]'::vector)::real[];
 float4  
---------
 {1,2,3}
(1 row)

-- Array cast errors
SELECT ARRAY[1.0, NULL, 3.0]::real[]::vector; -- error: null
ERROR:  array must not contain nulls
SELECT '{}'::real[]::vector; -- error: empty
ERROR:  array must not be empty
-- Comparison operators
SELECT '[1,2,3]'::vector < '[1,2,4]'::vector;
 ?column? 
----------
 t
(1 row)

SELECT '[1,2,3]'::vector = '[1,2,3]'::vector;
 ?column? 
----------
 t
(1 row)

SELECT '[1,2,3]'::vector > '[1,2,2]'::vector;
 ?column? 
----------
 t
(1 row)

SELECT '[1,2,3]'::vector <> '[1,2,4]'::vector;
 ?column? 
----------
 t
(1 row)

SELECT '[1,2,3]'::vector <= '[1,2,3]'::vector;
 ?column? 
----------
 t
(1 row)

SELECT '[1,2,3]'::vector >= '[1,2,3]'::vector;
 ?column? 
----------
 t
(1 row)

-- ORDER BY (btree opclass)
SELECT v FROM t_vec ORDER BY v;
    v    
---------
 [0,0,1]
 [0,1,0]
 [1,0,0]
(3 rows)

DROP TABLE t_vec;
