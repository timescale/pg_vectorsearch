Parsed test spec with 2 sessions

starting permutation: b_build w_poll w_wake b_done
step b_build: 
    CREATE INDEX i_prog ON emb USING mktann (v) WITH (nlist = 32);

s_watch: NOTICE:  tuples_done advanced mid-scan: f
step w_poll: 
    DO $$
    DECLARE
        observed bool := false;
    BEGIN
        FOR i IN 1..50 LOOP
            PERFORM 1 FROM pg_stat_progress_create_index
                WHERE tuples_done > 0;
            IF FOUND THEN
                observed := true;
                EXIT;
            END IF;
            PERFORM pg_sleep(0.1);
        END LOOP;
        RAISE NOTICE 'tuples_done advanced mid-scan: %', observed;
    END $$;

