-- Vector type I/O, typmod, casts, comparison
-- Basic I/O
SELECT '[1,2,3]'::vec32;
  vec32  
---------
 [1,2,3]
(1 row)

SELECT '[1.5,-2.3,0]'::vec32;
    vec32     
--------------
 [1.5,-2.3,0]
(1 row)

SELECT '[0]'::vec32;
 vec32 
-------
 [0]
(1 row)

-- Typmod
SELECT '[1,2,3]'::vec32(3);
  vec32  
---------
 [1,2,3]
(1 row)

-- Typmod mismatch
SELECT '[1,2,3]'::vec32(2); -- error
ERROR:  expected 2 dimensions, not 3
-- Empty vec32
SELECT '[]'::vec32; -- error
ERROR:  vec32 must have at least 1 dimension
LINE 1: SELECT '[]'::vec32;
               ^
-- NaN
SELECT '[1,NaN,3]'::vec32; -- error
ERROR:  NaN value not allowed in vec32
LINE 1: SELECT '[1,NaN,3]'::vec32;
               ^
-- Inf
SELECT '[1,Inf,3]'::vec32; -- error
ERROR:  infinite value not allowed in vec32
LINE 1: SELECT '[1,Inf,3]'::vec32;
               ^
-- Bad syntax
SELECT '[1,2,'::vec32; -- error
ERROR:  invalid input syntax for type vec32: "[1,2,"
LINE 1: SELECT '[1,2,'::vec32;
               ^
SELECT '1,2,3'::vec32; -- error
ERROR:  vec32 must start with "["
LINE 1: SELECT '1,2,3'::vec32;
               ^
SELECT '[1 2]'::vec32; -- error: missing comma
ERROR:  expected "," or "]" in vec32
LINE 1: SELECT '[1 2]'::vec32;
               ^
SELECT '[1,2]abc'::vec32; -- error: trailing content
ERROR:  unexpected characters after "]" in vec32
LINE 1: SELECT '[1,2]abc'::vec32;
               ^
-- Leading/trailing whitespace
SELECT '  [1,2,3]  '::vec32;
  vec32  
---------
 [1,2,3]
(1 row)

-- Spaces between elements
SELECT '[ 1 , 2 , 3 ]'::vec32;
  vec32  
---------
 [1,2,3]
(1 row)

-- Utility functions
SELECT vec32_dims('[1,2,3]'::vec32);
 vec32_dims 
------------
          3
(1 row)

SELECT vec32_norm('[3,4]'::vec32);
 vec32_norm 
------------
          5
(1 row)

-- Table storage
CREATE TABLE t_vec (id serial, v vec32(3));
INSERT INTO t_vec (v) VALUES ('[1,0,0]'), ('[0,1,0]'), ('[0,0,1]');
SELECT * FROM t_vec ORDER BY id;
 id |    v    
----+---------
  1 | [1,0,0]
  2 | [0,1,0]
  3 | [0,0,1]
(3 rows)

-- Array cast
SELECT ARRAY[1.0,2.0,3.0]::real[]::vec32;
  array  
---------
 [1,2,3]
(1 row)

SELECT ARRAY[1.0,2.0,3.0]::float8[]::vec32;
  array  
---------
 [1,2,3]
(1 row)

-- Vector to array
SELECT ('[1,2,3]'::vec32)::real[];
 float4  
---------
 {1,2,3}
(1 row)

-- Array cast errors
SELECT ARRAY[1.0, NULL, 3.0]::real[]::vec32; -- error: null
ERROR:  array must not contain nulls
SELECT '{}'::real[]::vec32; -- error: empty
ERROR:  array must not be empty
-- Comparison operators
SELECT '[1,2,3]'::vec32 < '[1,2,4]'::vec32;
 ?column? 
----------
 t
(1 row)

SELECT '[1,2,3]'::vec32 = '[1,2,3]'::vec32;
 ?column? 
----------
 t
(1 row)

SELECT '[1,2,3]'::vec32 > '[1,2,2]'::vec32;
 ?column? 
----------
 t
(1 row)

SELECT '[1,2,3]'::vec32 <> '[1,2,4]'::vec32;
 ?column? 
----------
 t
(1 row)

SELECT '[1,2,3]'::vec32 <= '[1,2,3]'::vec32;
 ?column? 
----------
 t
(1 row)

SELECT '[1,2,3]'::vec32 >= '[1,2,3]'::vec32;
 ?column? 
----------
 t
(1 row)

-- ORDER BY (btree opclass)
SELECT v FROM t_vec ORDER BY v;
    v    
---------
 [0,0,1]
 [0,1,0]
 [1,0,0]
(3 rows)

DROP TABLE t_vec;
