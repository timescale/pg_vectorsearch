-- Build-identity functions: extension_name(), extension_version(),
-- and git_commit() report what the loaded library was built as.
-- Verify the contracts without printing the actual hash so the
-- expected output stays deterministic across builds.
SELECT extension_name();
 extension_name 
----------------
 meerkat
(1 row)

-- The binary's version must match the installed extension's version;
-- a mismatch means the library and the SQL scripts come from
-- different builds (e.g. a stale install).
SELECT extension_version() =
    (SELECT extversion FROM pg_extension WHERE extname = extension_name())
    AS version_matches_extension;
 version_matches_extension 
---------------------------
 t
(1 row)

-- Format: 40-char lowercase hex (git's full SHA-1) or the "unknown"
-- fallback used when vcs_tag had no git checkout available (e.g. a
-- build from a release tarball).
SELECT git_commit() ~ '^([0-9a-f]{40}|unknown)$' AS git_commit_shape;
 git_commit_shape 
------------------
 t
(1 row)

-- Callers (e.g. rekall) consume these as strings, so the return type
-- must be text, and all three must be IMMUTABLE STRICT PARALLEL SAFE:
-- the values don't change within a backend's lifetime, the inputs are
-- void so STRICT is trivially satisfied, and there's no per-backend
-- state that would break parallel workers.
SELECT
    p.proname,
    p.prorettype::regtype::text = 'text' AS returns_text,
    p.provolatile      = 'i' AS immutable,
    p.proisstrict            AS strict,
    p.proparallel      = 's' AS parallel_safe
FROM pg_proc p
JOIN pg_namespace n ON n.oid = p.pronamespace
WHERE n.nspname = 'mkt'
  AND p.proname IN ('git_commit', 'extension_name', 'extension_version')
ORDER BY p.proname;
      proname      | returns_text | immutable | strict | parallel_safe 
-------------------+--------------+-----------+--------+---------------
 extension_name    | t            | t         | t      | t
 extension_version | t            | t         | t      | t
 git_commit        | t            | t         | t      | t
(3 rows)

