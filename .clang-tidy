---
# Clang-tidy configuration for pg_vectorsearch
#
# Disable checks that don't apply to portable C code or PostgreSQL extensions.

# Analyzer findings fail the run. Without this clang-tidy exits 0 on
# warnings and pre-commit, which prints hook output only on failure,
# discards them -- so a finding would be reported and CI would stay green.
WarningsAsErrors: 'clang-analyzer-*'

Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

# The insecureAPI.DeprecatedOrUnsafeBufferHandling check recommends memcpy_s
# and memset_s which are C11 Annex K functions. These are optional and not
# implemented by glibc, making them unsuitable for portable code.
